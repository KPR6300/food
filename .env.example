# Set these as environment variables in your hosting provider's dashboard.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
UPI_ID=merchant@bank
UPI_PAYEE_NAME=Kitchen Name
# Optional. Set all three to enable the My orders SMS verification flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
NODE_ENV=production
PORT=3000
# Set ORDERS_FILE to a persistent disk path if your host has an ephemeral filesystem.
